    "connect.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code works once, for ten minutes. A connected AI sees your pieces, outfits, photos and comments, and can suggest changes. You can disconnect it any time."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice vale una volta, per dieci minuti. Un'IA collegata vede capi, abbinamenti, foto e commenti, e può proporre modifiche. Puoi scollegarla quando vuoi."
          }
        }
      }
    },
    "connect.newCode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code expired. Get a new one"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice è scaduto. Generane uno nuovo"
          }
        }
      }
    },
    "connect.step1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. In your AI app, add a custom connector with this address:"
