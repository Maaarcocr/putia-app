    "bench.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Putia has no AI inside. You can connect your own, such as Claude: it works on the same records as you, and everything it changes shows up here and can be undone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Putia non contiene un'IA. Puoi collegare la tua, per esempio Claude: lavora sugli stessi dati tuoi, e ogni sua modifica compare qui e si può annullare."
          }
        }
      }
    },
    "bench.noHistory": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No changes yet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna modifica."
          }
        }
      }
    },
