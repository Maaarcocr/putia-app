    "closet.empty.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a piece from a photo. Putia cuts it out; tag it yourself, or let a connected AI suggest tags."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un capo da una foto. Putia lo scontorna; aggiungi tu le etichette, o lascia che le suggerisca un'IA collegata."
          }
        }
      }
    },
