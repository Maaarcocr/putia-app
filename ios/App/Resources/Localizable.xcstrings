    "bench.deleteEverything": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete everything"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tutto"
          }
        }
      }
    },
    "bench.deleteEverything.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes every piece, outfit, photo and comment from Putia's server and disconnects all AIs. This can't be undone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina dal server di Putia ogni capo, abbinamento, foto e commento, e scollega tutte le IA. Non si può annullare."
          }
        }
      }
    },
    "bench.deleteEverything.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete everything?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare tutto?"
          }
        }
      }
    },
    "bench.disconnect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect all AIs"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scollega tutte le IA"
          }
        }
      }
    },
    "bench.disconnect.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They lose access at once. What they already changed stays."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdono subito l'accesso. Le modifiche già fatte restano."
          }
        }
      }
    },
    "bench.disconnect.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect all AIs?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scollegare tutte le IA?"
          }
        }
      }
    },
    "bench.history": {
      "localizations": {
