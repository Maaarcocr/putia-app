{
  // The Putia studio server: the shared records, photos and the AI connector (/mcp).
  // Create the resources once, then paste their IDs below (see docs/architecture.md, "Deploying"):
  //   npx wrangler d1 create putia
  //   npx wrangler r2 bucket create putia-photos
  //   npx wrangler kv namespace create putia-oauth
  // The placeholder IDs are fine for `wrangler dev`, which simulates everything locally.
  "name": "putia",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // global_fetch_strictly_public: required by the OAuth library for Client ID Metadata Documents.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "d1_databases": [
    { "binding": "DB", "database_name": "putia", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "putia-photos" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "observability": { "enabled": true }
}
